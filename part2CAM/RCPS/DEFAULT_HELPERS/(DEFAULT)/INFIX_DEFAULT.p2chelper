;prefvars
; General infix parameters. Pocket geometry is fixed (manufacturer drawing OP-3 v2 -> _INFIXMAIN)
(_SETA 'INFIX_HOR_DIAMETER 8.0)
(_SETA 'INFIX_HOR_DEPTH 12.0)
(_SETA 'INFIX_VER_DEPTH 14.3)

; Overrun of the pocket outside the panel edge (manufacturer drawing OP-3 v2: 3.5)
(_SETA 'INFIX_EXTENSION 3.5)

; Distance of bolt axis from panel face
(_SETA 'INFIX_BOLT_HOLE_POS 9.0)
(_FSET (_ 'INFIX_BOLT_HOLE_POS (- __AD_PANELTHICK INFIX_BOLT_HOLE_POS)))

(_SETA 'INFIX_CODE "INFIX_STANDARD")
(_SETA 'INFIX_UNIT "kit")

; All infix parameters set to a list
(_FSET (_ 'INFIX_PARAMETERS (_ INFIX_HOR_DIAMETER INFIX_HOR_DEPTH INFIX_VER_DEPTH INFIX_EXTENSION INFIX_CODE INFIX_UNIT)))

(_NONOTCH)
