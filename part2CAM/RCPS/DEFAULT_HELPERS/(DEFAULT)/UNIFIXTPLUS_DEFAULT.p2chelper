;prefvars
; General unifixt plus parameters. Tool path and flange geometry is fixed (UNIFIXTPLUSTAKIMYOLU.dxf -> _UNIFIXTPLUSMAIN)
(_SETA 'UNIFIXTPLUS_HOR_DIAMETER 8.0)
(_SETA 'UNIFIXTPLUS_HOR_DEPTH 14.0)
; Manufacturer schema: tool path depth 11.2 without flange, 11.2 + 1.0 = 12.2 with flange
(_SETA 'UNIFIXTPLUS_VER_DEPTH 11.2)

(_SETA 'UNIFIXTPLUS_ADD_FLANGE T)
(_SETA 'UNIFIXTPLUS_FLANGE_DEPTH 1.0)

; Distance of bolt axis from panel face (flange depth is added if flange exists)
; Manufacturer schema (18 mm panel): opposite hole 13 mm from the bottom edge without flange, 12 mm with flange -> 5 / 6 mm from the face
(_SETA 'UNIFIXTPLUS_BOLT_HOLE_POS 5.0)
(_FSET (_ 'UNIFIXTPLUS_BOLT_HOLE_POS (- __AD_PANELTHICK UNIFIXTPLUS_BOLT_HOLE_POS)))

(_SETA 'UNIFIXTPLUS_CODE "UNIFIXTPLUS_STANDARD")
(_SETA 'UNIFIXTPLUS_UNIT "kit")

; Connector sits deeper by flange depth (pocket depth is increased inside _UNIFIXTPLUSMAIN)
(if UNIFIXTPLUS_ADD_FLANGE
	(_FSET (_ 'UNIFIXTPLUS_BOLT_HOLE_POS (- UNIFIXTPLUS_BOLT_HOLE_POS UNIFIXTPLUS_FLANGE_DEPTH)))
)

; All unifixt plus parameters set to a list
(_FSET (_ 'UNIFIXTPLUS_PARAMETERS (_ UNIFIXTPLUS_HOR_DIAMETER UNIFIXTPLUS_HOR_DEPTH UNIFIXTPLUS_VER_DEPTH UNIFIXTPLUS_ADD_FLANGE UNIFIXTPLUS_FLANGE_DEPTH UNIFIXTPLUS_CODE UNIFIXTPLUS_UNIT)))

(_NONOTCH)
