; UNIFIXTPLUS connector. Geometry: _UNIFIXTPLUSMAIN (lmmusercoms.lsp)
(setq WARDROBE_UNIFIXTPLUS_HOR_HOLE_DIA (cu2mm UNIFIXTPLUS_DIA))
(setq WARDROBE_UNIFIXTPLUS_HOR_HOLE_DEPTH (cu2mm UNIFIXTPLUS_DEP))
(setq WARDROBE_UNIFIXTPLUS_VER_HOLE_DEPTH (cu2mm UNIFIXTPLUS_DEP2))
(setq WARDROBE_UNIFIXTPLUS_AXIS_POS (cu2mm UNIFIXTPLUS_D))

(setq WARDROBE_UNIFIXTPLUS_ADD_FLANGE (equal UNIFIXTPLUS_W_ADD_FLANGE 1.0))
(setq WARDROBE_UNIFIXTPLUS_FLANGE_DEPTH (cu2mm UNIFIXTPLUS_W_FLANGE_DEPTH))
(if WARDROBE_UNIFIXTPLUS_ADD_FLANGE (setq WARDROBE_UNIFIXTPLUS_AXIS_POS (+ WARDROBE_UNIFIXTPLUS_AXIS_POS WARDROBE_UNIFIXTPLUS_FLANGE_DEPTH)))

(_RUNDEFAULTHELPERRCP "WARDROBE_DEFAULT" nil "p2chelper")

(_FSET (_ 'connectorInfo (_GETTOUCHES)))
(_FSET (_ 'targetPanels (getnth 2 connectorInfo)))
(if (equal (length targetPanels) 2)
	(progn
		(_FSET (_ 'panelCounter 0))
		(repeat (length targetPanels)
			(_FSET (_ 'tPanelInfo (getnth panelCounter targetPanels)))
			(_SETCURMODUL (getnth 0 tPanelInfo))
			
			(_FSET (_ 'connectedFaceCode WARDROBE_PANELS_GENERAL_CODE))
			(_FSET (_ 'currentFaceNormal (getnth 1 tPanelInfo)))
			
			(_FSET (_ 'holePosition (mapcar '(lambda(x) (cu2mm x)) (getnth 7 tPanelInfo))))
			(_FSET (_ 'holeOrient (_DETERMINEHOLEORIENT currentFaceNormal)))
			(cond
				((_ISVERTICALFACE currentFaceNormal)
					; Bolt hole on the face of the opposite panel. Type of current face is either 0 or 1 in this case
					(setq holePosition (replace 0 2 holePosition))
					(if (equal (_DETERMINEFACETYPE currentFaceNormal) 1)
						(_FSET (_ 'connectedFaceCode (_& (_ connectedFaceCode "!!SFACE"))))
					)
					(_FSET (_ 'holeCodeBody (_& (_ connectedFaceCode "_UNIFIXTPLUS_VER_HOLE"))))
					(_HOLE holeCodeBody connectedFaceCode (_ holePosition WARDROBE_UNIFIXTPLUS_HOR_HOLE_DIA WARDROBE_UNIFIXTPLUS_HOR_HOLE_DEPTH holeOrient))
				)
				((_ISHORIZONTALFACE currentFaceNormal)
					; Pocket on the face of the edge panel. Type of current face is either 2, 3, 4 or 5 in this case
					(if (null (minusp (getnth 2 holePosition)))
						(setq holePosition (replace (* (getnth 2 holePosition) -1) 2 holePosition))
					)
					(if (not (equal (* -1 (getnth 2 holePosition)) WARDROBE_UNIFIXTPLUS_AXIS_POS 0.01))
						(_FSET (_ 'connectedFaceCode (_& (_ connectedFaceCode "!!SFACE"))))
					)
					(setq holePosition (replace 0 2 holePosition))
					
					(_FSET (_ 'holeCodeBody (_& (_ connectedFaceCode "_UNIFIXTPLUS_HOR_HOLE"))))
					(_UNIFIXTPLUSMAIN holeCodeBody connectedFaceCode (_ holePosition (_ WARDROBE_UNIFIXTPLUS_HOR_HOLE_DIA WARDROBE_UNIFIXTPLUS_HOR_HOLE_DEPTH WARDROBE_UNIFIXTPLUS_VER_HOLE_DEPTH WARDROBE_UNIFIXTPLUS_ADD_FLANGE WARDROBE_UNIFIXTPLUS_FLANGE_DEPTH WARDROBE_UNIFIXTPLUS_CODE WARDROBE_UNIFIXTPLUS_UNIT nil)) holeOrient)
				)
			)
			(_RESETCURMODUL)
			(_FSET (_ 'panelCounter (+ 1 panelCounter)))
		)
		(_SETCURMODUL __CONNECTORPARENT)
		(_RESETCURMODUL)
	)
)
(_NONOTCH)
