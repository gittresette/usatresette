; Notch variant of fixed shelf operations - replaces holes on notched panels
(if (and (_NOTNULL CORNER_UNIT_CONTROL) (_NOTNULL AK_FIXED_SHELF_ELEV_LIST)
		 (or (equal __MODULTYPE "AK2") (equal __MODULTYPE "UK2") (equal __MODULTYPE "AK3") (equal __MODULTYPE "UK3")))
	(progn
		(_FSET (_ 'shelfCounter 1))
		(repeat (length AK_FIXED_SHELF_ELEV_LIST)
			(_FSET (_ 'currentShelfCODE (_& (_ (XSTR "CORNER_UNIT") "_" (XSTR "NOTCHED_FIXED_SHELF") "_" shelfCounter))))

			(if (_EXISTPANEL currentShelfCODE)
				(progn
					(_FSET (_ 'paramBody (_& (_ "AK_NOTCHED_FIXED_SHELF_" shelfCounter "_"))))

					; Retrieve stored shelf dimensions
					(_FSET (_ 'currentShelfHEI (_S2V (_& (_ paramBody "HEI")))))
					(_FSET (_ 'currentShelfWID (_S2V (_& (_ paramBody "WID")))))
					(_FSET (_ 'currentShelfDEP (_S2V (_& (_ paramBody "DEP")))))
					(_FSET (_ 'currentShelfDEP2 (_S2V (_& (_ paramBody "DEP2")))))
					(_FSET (_ 'currentShelfELEV (_S2V (_& (_ paramBody "ELEV")))))
					(_FSET (_ 'currentShelfTHICKNESS (_S2V (_& (_ paramBody "THICKNESS")))))
					(_FSET (_ 'currentShelfNHEI (_S2V (_& (_ paramBody "NHEI")))))
					(_FSET (_ 'currentShelfNWID (_S2V (_& (_ paramBody "NWID")))))

					; Face selection for operation
					(if (_NOTNULL FIXED_SHELF_HOLES_ON_LOWER_SURFACE)
						(progn
							(_FSET (_ 'currentShelfPDATA (_S2V (_& (_ paramBody "PDATA")))))
							(_FSET (_ 'currentShelfROT (_S2V (_& (_ paramBody "ROT")))))
							(_FSET (_ 'currentShelfMAT (_S2V (_& (_ paramBody "MAT")))))

							(_FSET (_ 'currentShelfCODE (_CREATESFACEMAIN currentShelfCODE (_ currentShelfPDATA currentShelfROT currentShelfMAT currentShelfTHICKNESS "Y"))))
						)
					)

					; Calculate intersection lengths between notched fixed shelf and side panels
					; Left side connection: shelf's HEI edge (X=HEI, along DEP2 axis)
					(_FSET (_ 'lengthParametersForShelfAndLeft (_CALCULATEPANELSINTERSECTIONLENGTH currentShelfDEP2 (_ 0 0 LEFT_PANEL_FRONT_VARIANCE LEFT_PANEL_BACK_VARIANCE))))
					(mapcar '_SETA '(lengthForShelfAndLeft frontStartingPointShelfL backStartingPointShelfL frontStartingPointLeft backStartingPointLeft) lengthParametersForShelfAndLeft)

					; Right side connection: shelf's WID edge (Y=WID, along DEP axis)
					(_FSET (_ 'lengthParametersForShelfAndRight (_CALCULATEPANELSINTERSECTIONLENGTH currentShelfDEP (_ 0 0 RIGHT_PANEL_FRONT_VARIANCE RIGHT_PANEL_BACK_VARIANCE))))
					(mapcar '_SETA '(lengthForShelfAndRight frontStartingPointShelfR backStartingPointShelfR frontStartingPointRight backStartingPointRight) lengthParametersForShelfAndRight)

					(_FSET (_ 'halfOfThickness (/ currentShelfTHICKNESS 2.0)))
					(_FSET (_ 'holePosOnAxisY (_= "currentShelfELEV + halfOfThickness + bottomSideStyleV2")))

					; Calculate intersection lengths for secondary panels
					(if (_EXISTPANEL AK_SECONDARY_LEFT_PANEL_CODE)
						(progn
							(_FSET (_ 'secLeftLengthParams (_CALCULATEPANELSINTERSECTIONLENGTH AK_SECONDARY_LEFT_PANEL_WID (_ 0 0 0 0))))
							(mapcar '_SETA '(lengthForShelfAndSecLeft frontSSL backSSL frontSLPanel backSLPanel) secLeftLengthParams)
						)
					)
					(if (_EXISTPANEL AK_SECONDARY_RIGHT_PANEL_CODE)
						(progn
							(_FSET (_ 'secRightLengthParams (_CALCULATEPANELSINTERSECTIONLENGTH AK_SECONDARY_RIGHT_PANEL_WID (_ 0 0 0 0))))
							(mapcar '_SETA '(lengthForShelfAndSecRight frontSSR backSSR frontSRPanel backSRPanel) secRightLengthParams)
						)
					)

					(foreach operationParams OPERATION_LIST
						(mapcar '_SETA '(operationName connectorParams horizontalHolePos) operationParams)

						; --- Holes on NOTCHED FIXED SHELF for LEFT side panel ---
						(_FSET (_ 'shelfPointListForLeftSide (_GETHOLEPOINTLIST operationName 
							(_ lengthForShelfAndLeft currentShelfHEI (car horizontalHolePos) "Y") 
							(_ frontStartingPointShelfL backStartingPointShelfL nil currentShelfDEP2) 
							(_ FITTING_PARAMETERS nil))))
						(_HOLEGROUP operationName currentShelfCODE shelfPointListForLeftSide (_ "X-" nil) connectorParams)

						; --- Holes on NOTCHED FIXED SHELF for RIGHT side panel ---
						(_FSET (_ 'shelfPointListForRightSide (_GETHOLEPOINTLIST operationName 
							(_ lengthForShelfAndRight currentShelfWID (car horizontalHolePos) "X") 
							(_ frontStartingPointShelfR backStartingPointShelfR nil currentShelfDEP) 
							(_ FITTING_PARAMETERS nil))))
						(_HOLEGROUP operationName currentShelfCODE shelfPointListForRightSide (_ "Y-" nil) connectorParams)

						; --- Holes on LEFT side panel for fixed shelf ---
						(if (_EXISTPANEL AK_LEFT_PANEL_CODE)
							(progn
								(_FSET (_ 'leftPanelPointListForShelf (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndLeft holePosOnAxisY 0 "X") 
									(_ (+ frontStartingPointLeft FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE FIXED_SHELF_FRONT_OFFSET) (- backStartingPointLeft FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE FIXED_SHELF_FRONT_OFFSET) nil currentShelfDEP2) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName AK_LEFT_PANEL_CODE leftPanelPointListForShelf (_ nil "Y-") connectorParams)
							)
						)

						; --- Holes on RIGHT side panel for fixed shelf ---
						(if (_EXISTPANEL AK_RIGHT_PANEL_CODE)
							(progn
								(_FSET (_ 'rightPanelPointListForShelf (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndRight holePosOnAxisY 0 "X") 
									(_ (_= "currentShelfDEP - AK_RIGHT_PANEL_WID + frontStartingPointRight + FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE + FIXED_SHELF_FRONT_OFFSET") (_= "AK_RIGHT_PANEL_WID - currentShelfDEP + backStartingPointRight - FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE - FIXED_SHELF_FRONT_OFFSET") T currentShelfDEP) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName AK_RIGHT_PANEL_CODE rightPanelPointListForShelf (_ nil "Y-") connectorParams)
							)
						)

						; --- Holes on NOTCHED FIXED SHELF for SECONDARY LEFT side panel ---
						(if (_EXISTPANEL AK_SECONDARY_LEFT_PANEL_CODE)
							(progn
								(_FSET (_ 'shelfPointListForSecLeft (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndSecLeft currentShelfNHEI (car horizontalHolePos) "Y") 
									(_ frontSSL backSSL nil AK_SECONDARY_LEFT_PANEL_WID) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName currentShelfCODE shelfPointListForSecLeft (_ "X+" nil) connectorParams)
							)
						)

						; --- Holes on SECONDARY LEFT side panel for fixed shelf ---
						(if (_EXISTPANEL AK_SECONDARY_LEFT_PANEL_CODE)
							(progn
								(_FSET (_ 'secLeftPanelPointList (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndSecLeft holePosOnAxisY 0 "X") 
									(_ (+ frontSLPanel FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE) (- backSLPanel FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE) nil AK_SECONDARY_LEFT_PANEL_WID) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName AK_SECONDARY_LEFT_PANEL_CODE secLeftPanelPointList (_ nil "Y-") connectorParams)
							)
						)

						; --- Holes on NOTCHED FIXED SHELF for SECONDARY RIGHT side panel ---
						(if (_EXISTPANEL AK_SECONDARY_RIGHT_PANEL_CODE)
							(progn
								(_FSET (_ 'shelfPointListForSecRight (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndSecRight currentShelfNWID (car horizontalHolePos) "X") 
									(_ frontSSR backSSR nil AK_SECONDARY_RIGHT_PANEL_WID) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName currentShelfCODE shelfPointListForSecRight (_ "Y+" nil) connectorParams)
							)
						)

						; --- Holes on SECONDARY RIGHT side panel for fixed shelf ---
						(if (_EXISTPANEL AK_SECONDARY_RIGHT_PANEL_CODE)
							(progn
								(_FSET (_ 'secRightPanelPointList (_GETHOLEPOINTLIST operationName 
									(_ lengthForShelfAndSecRight holePosOnAxisY 0 "X") 
									(_ (+ frontSRPanel FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE) (- backSRPanel FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE) T AK_SECONDARY_RIGHT_PANEL_WID) 
									(_ FITTING_PARAMETERS nil))))
								(_HOLEGROUP operationName AK_SECONDARY_RIGHT_PANEL_CODE secRightPanelPointList (_ nil "Y-") connectorParams)
							)
						)
					)
				)
			)
			(_FSET (_ 'shelfCounter (+ shelfCounter 1)))
		)
	)
)