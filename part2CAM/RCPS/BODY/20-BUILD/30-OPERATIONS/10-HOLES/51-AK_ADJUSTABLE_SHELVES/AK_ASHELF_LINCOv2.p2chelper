; Corner unit adjustable shelf lincov2 recipe

(_RUNDEFAULTHELPERRCP "LINCOv2_DEFAULT" nil "p2chelper")

(_FSET (_ 'currentShelfCODE (_& (_ (XSTR "CORNER_UNIT") "_" (XSTR "ADJUSTABLE_SHELF") "_" divisionCounter "_" shelfCounter))))
(_FSET (_ 'paramBody (_& (_ "AK_ADJUSTABLE_SHELF_" divisionCounter "_" shelfCounter "_"))))
; Global parameters of current shelf
(_FSET (_ 'currentShelfHEI (_S2V (_& (_ paramBody "HEI")))))
(_FSET (_ 'currentShelfWID (_S2V (_& (_ paramBody "WID")))))
(_FSET (_ 'currentShelfDEP (_S2V (_& (_ paramBody "DEP")))))
(_FSET (_ 'currentShelfDEP2 (_S2V (_& (_ paramBody "DEP2")))))
(_FSET (_ 'currentShelfELEV (if (_S2V (_& (_ paramBody "ELEV"))) (_S2V (_& (_ paramBody "ELEV"))) 0.0)))
(_FSET (_ 'currentShelfTHICKNESS (_S2V (_& (_ paramBody "THICKNESS")))))

(if (_EXISTPANEL currentShelfCODE)
	(progn
		(if (_NOTNULL ASHELF_HOLES_ON_LOWER_SURFACE)
			(progn
				(_FSET (_ 'shelfROT (_S2V (_& (_ paramBody "ROT")))))
				(_FSET (_ 'shelfMAT (_S2V (_& (_ paramBody "MAT")))))
				(_FSET (_ 'shelfPDATA (_S2V (_& (_ paramBody "PDATA")))))
				
				(_FSET (_ 'currentShelfCODE (_CREATESFACEMAIN currentShelfCODE (_ shelfPDATA shelfROT shelfMAT currentShelfTHICKNESS "X"))))
			)
		)
		(if (or (and (>= currentShelfHEI LIMIT_FOR_MIDDLE_HOLE_GROUP) (>= currentShelfWID LIMIT_FOR_MIDDLE_HOLE_GROUP)) (_NOTNULL IS_MIDDLE_HOLE_GROUP_AVAILABLE))
			(progn
				(_FSET (_ 'thirdLincov2 T))
				(_FSET (_ 'thirdLincov2OffsetDEP (+ (/ currentShelfDEP 2.0) MIDDLE_HOLE_GROUP_OFFSET_FROM_CENTER_OF_SIDE ASHELF_FRONT_OFFSET)))
				(_FSET (_ 'thirdLincov2OffsetDEP2 (+ (/ currentShelfDEP2 2.0) MIDDLE_HOLE_GROUP_OFFSET_FROM_CENTER_OF_SIDE ASHELF_FRONT_OFFSET)))
			)
			(_FSET (_ 'thirdLincov2 nil))
		)
		(_FSET (_ 'leftFrontHolePosX currentShelfHEI))
		(_FSET (_ 'leftFrontHolePosY (- currentShelfDEP2 ASHELF_FRONT_HOLE_OFFSET)))
		(_FSET (_ 'leftBackHolePosX currentShelfHEI))
		(_FSET (_ 'leftBackHolePosY ASHELF_BACK_HOLE_OFFSET))

		(_FSET (_ 'rightFrontHolePosX (- currentShelfDEP ASHELF_FRONT_HOLE_OFFSET)))
		(_FSET (_ 'rightFrontHolePosY currentShelfWID))
		(_FSET (_ 'rightBackHolePosX ASHELF_BACK_HOLE_OFFSET))
		(_FSET (_ 'rightBackHolePosY currentShelfWID))
		(if (_NOTNULL thirdLincov2)
			(progn
				(_FSET (_ 'leftThirdHolePosX currentShelfHEI))
				(_FSET (_ 'leftThirdHolePosY (_= "currentShelfDEP2 - thirdLincov2OffsetDEP2 + ASHELF_FRONT_OFFSET")))
				
				(_FSET (_ 'rightThirdHolePosX (_= "currentShelfDEP - thirdLincov2OffsetDEP + ASHELF_FRONT_OFFSET")))
				(_FSET (_ 'rightThirdHolePosY currentShelfWID))
			)
		)
		(_FSET (_ 'leftFrontHolePos (_ leftFrontHolePosX leftFrontHolePosY 0)))
		(_FSET (_ 'leftBackHolePos (_ leftBackHolePosX leftBackHolePosY 0)))
		(_FSET (_ 'rightFrontHolePos (_ rightFrontHolePosX rightFrontHolePosY 0)))
		(_FSET (_ 'rightBackHolePos (_ rightBackHolePosX rightBackHolePosY 0)))

		(_LINCOv2MAIN "LF" currentShelfCODE (_ leftFrontHolePos LINCOv2_PARAMETERS) "X-")
		(_LINCOv2MAIN "LB" currentShelfCODE (_ leftBackHolePos LINCOv2_PARAMETERS) "X-")
		(_LINCOv2MAIN "RF" currentShelfCODE (_ rightFrontHolePos LINCOv2_PARAMETERS) "Y-")
		(_LINCOv2MAIN "RB" currentShelfCODE (_ rightBackHolePos LINCOv2_PARAMETERS) "Y-")
		(_ITEMMAIN LINCOv2_CODE currentShelfCODE (_ (* QUANTITY_OF_ITEM 4) LINCOv2_UNIT))
		(if (_NOTNULL thirdLincov2)
			(progn
				(_FSET (_ 'leftMiddleHolePos (_ leftThirdHolePosX leftThirdHolePosY 0)))
				(_FSET (_ 'rightMiddleHolePos (_ rightThirdHolePosX rightThirdHolePosY 0)))
				
				(_LINCOv2MAIN "LM" currentShelfCODE (_ leftMiddleHolePos LINCOv2_PARAMETERS) "X-")
				(_LINCOv2MAIN "RM" currentShelfCODE (_ rightMiddleHolePos LINCOv2_PARAMETERS) "Y-")
				(_ITEMMAIN LINCOv2_CODE currentShelfCODE (_ (* QUANTITY_OF_ITEM 2) LINCOv2_UNIT))
			)
		)
		(_FSET (_ 'halfOfThickness (/ currentShelfTHICKNESS 2.0)))
		(_FSET (_ 'currentDivisionELEV (_S2V (_& (_ currentDivision "_STARTFROMBOTTOM")))))
		(_FSET (_ 'holePosOnAxisYLeft (_= "currentDivisionELEV + currentShelfELEV + halfOfThickness - bottomSideStyleV1 + LEFT_PANEL_LOWER_VARIANCE")))
		(_FSET (_ 'holePosOnAxisYRight (_= "currentDivisionELEV + currentShelfELEV + halfOfThickness - bottomSideStyleV1 + RIGHT_PANEL_LOWER_VARIANCE")))
		(if (_EXISTPANEL AK_LEFT_PANEL_CODE)
			(progn
				(_LINCOv2MAIN "FRONT" AK_LEFT_PANEL_CODE (_ (_ (+ ASHELF_FRONT_OFFSET ASHELF_FRONT_HOLE_OFFSET) holePosOnAxisYLeft 0) LINCOv2_PARAMETERS) nil)
				(_LINCOv2MAIN "BACK" AK_LEFT_PANEL_CODE (_ (_ (_= "ASHELF_FRONT_OFFSET + currentShelfDEP2 - ASHELF_BACK_HOLE_OFFSET") holePosOnAxisYLeft 0) LINCOv2_PARAMETERS) nil)
				(if (_NOTNULL thirdLincov2)
					(_LINCOv2MAIN "MIDDLE" AK_LEFT_PANEL_CODE (_ (_ thirdLincov2OffsetDEP2 holePosOnAxisYLeft 0) LINCOv2_PARAMETERS) nil)
				)
			)
		)
		(if (_EXISTPANEL AK_RIGHT_PANEL_CODE)
			(progn
				(_LINCOv2MAIN "FRONT" AK_RIGHT_PANEL_CODE (_ (_ (_= "AK_RIGHT_PANEL_WID - ASHELF_FRONT_OFFSET - ASHELF_FRONT_HOLE_OFFSET") holePosOnAxisYRight 0) LINCOv2_PARAMETERS) nil)
				(_LINCOv2MAIN "BACK" AK_RIGHT_PANEL_CODE (_ (_ (_= "AK_RIGHT_PANEL_WID - ASHELF_FRONT_OFFSET - currentShelfDEP + ASHELF_BACK_HOLE_OFFSET") holePosOnAxisYRight 0) LINCOv2_PARAMETERS) nil)
				(if (_NOTNULL thirdLincov2)
					(_LINCOv2MAIN "MIDDLE" AK_RIGHT_PANEL_CODE (_ (_ (- AK_RIGHT_PANEL_WID thirdLincov2OffsetDEP) holePosOnAxisYRight 0) LINCOv2_PARAMETERS) nil)
				)
			)
		)
	)
)

