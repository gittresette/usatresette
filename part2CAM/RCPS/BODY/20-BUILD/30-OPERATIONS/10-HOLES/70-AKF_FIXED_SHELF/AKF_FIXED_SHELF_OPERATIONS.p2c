(_RUNDEFAULTHELPERRCP "AK_DEFAULT" nil "p2chelper")
(_RUNDEFAULTHELPERRCP "PANELS_JUNCTION_STYLES_DEFAULT" nil "p2chelper")
(_RUNDEFAULTHELPERRCP "FIXED_SHELF_DEFAULT" nil "p2chelper")
(_RUNDEFAULTHELPERRCP "CONNECTORS_DEFAULT" nil "p2chelper")
(_RUNDEFAULTHELPERRCP "OPERATIONS_DEFAULT" nil "p2chelper")

(if (_NOTNULL USE_PROJECT_PRICING_RECIPES)
	(progn
		; If project pricing recipes will be used instead of operations then there is no need for notch operations also
		(_NONOTCH)
	)
	(progn
		(if (and (_NOTNULL CORNER_UNIT_CONTROL) (equal __MODULTYPE "AKF") (_EXISTPANEL AKF_FIXED_SHELF_CODE))
			(progn
				; Calculate intersection lengths between fixed shelf edges and side panels
				; Left side connection: shelf edge at X=HEI, running along DEP2 direction (Y axis)
				(_FSET (_ 'lengthParametersForShelfAndLeft (_CALCULATEPANELSINTERSECTIONLENGTH AKF_FIXED_SHELF_DEP2 (_ 0 0 0 0))))
				(mapcar '_SETA '(lengthForShelfAndLeft frontStartingPointShelfL backStartingPointShelfL frontStartingPointLeftForShelf backStartingPointLeftForShelf) lengthParametersForShelfAndLeft)

				; Right side connection: shelf edge at Y=WID, running along DEP direction (X axis)
				(_FSET (_ 'lengthParametersForShelfAndRight (_CALCULATEPANELSINTERSECTIONLENGTH AKF_FIXED_SHELF_DEP (_ 0 0 0 0))))
				(mapcar '_SETA '(lengthForShelfAndRight frontStartingPointShelfR backStartingPointShelfR frontStartingPointRightForShelf backStartingPointRightForShelf) lengthParametersForShelfAndRight)

				(_FSET (_ 'halfOfThickness (/ AKF_FIXED_SHELF_THICKNESS 2.0)))
				(_FSET (_ 'holePosOnAxisY (_= "AKF_FIXED_SHELF_ELEV + halfOfThickness - bottomSideStyleV1")))

				(foreach operationParams OPERATION_LIST
					(mapcar '_SETA '(operationName connectorParams horizontalHolePos) operationParams)

					; --- Holes on FIXED SHELF for LEFT side panel ---
					; Edge at X=AKF_FIXED_SHELF_HEI, holes distributed along Y (DEP2 direction), drilling X- into shelf
					(_FSET (_ 'shelfPointListForLeftSide (_GETHOLEPOINTLIST operationName 
						(_ lengthForShelfAndLeft AKF_FIXED_SHELF_HEI (car horizontalHolePos) "Y") 
						(_ frontStartingPointShelfL backStartingPointShelfL nil AKF_FIXED_SHELF_DEP2) 
						(_ FITTING_PARAMETERS nil))))
					(_HOLEGROUP operationName AKF_FIXED_SHELF_OP_FACE shelfPointListForLeftSide (_ "X-" nil) connectorParams)

					; --- Holes on FIXED SHELF for RIGHT side panel ---
					; Edge at Y=AKF_FIXED_SHELF_WID, holes distributed along X (DEP direction), drilling Y- into shelf
					(_FSET (_ 'shelfPointListForRightSide (_GETHOLEPOINTLIST operationName 
						(_ lengthForShelfAndRight AKF_FIXED_SHELF_WID (car horizontalHolePos) "X") 
						(_ frontStartingPointShelfR backStartingPointShelfR nil AKF_FIXED_SHELF_DEP) 
						(_ FITTING_PARAMETERS nil))))
					(_HOLEGROUP operationName AKF_FIXED_SHELF_OP_FACE shelfPointListForRightSide (_ "Y-" nil) connectorParams)

					; --- Holes on LEFT side panel for fixed shelf ---
					(if (_EXISTPANEL AK_LEFT_PANEL_CODE)
						(progn
							(_FSET (_ 'leftPanelPointListForShelf (_GETHOLEPOINTLIST operationName 
								(_ lengthForShelfAndLeft holePosOnAxisY 0 "X") 
								(_ (+ frontStartingPointLeftForShelf FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE FIXED_SHELF_FRONT_OFFSET) (- backStartingPointLeftForShelf FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE FIXED_SHELF_FRONT_OFFSET) nil AKF_FIXED_SHELF_DEP2) 
								(_ FITTING_PARAMETERS nil))))
							(_HOLEGROUP operationName AK_LEFT_PANEL_CODE leftPanelPointListForShelf (_ nil "Y-") connectorParams)
						)
					)

					; --- Holes on RIGHT side panel for fixed shelf ---
					(if (_EXISTPANEL AK_RIGHT_PANEL_CODE)
						(progn
							(_FSET (_ 'rightPanelPointListForShelf (_GETHOLEPOINTLIST operationName 
								(_ lengthForShelfAndRight holePosOnAxisY 0 "X") 
								(_ (_= "AKF_FIXED_SHELF_DEP - AK_RIGHT_PANEL_WID + frontStartingPointRightForShelf + FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE + FIXED_SHELF_FRONT_OFFSET") (_= "AK_RIGHT_PANEL_WID - AKF_FIXED_SHELF_DEP + backStartingPointRightForShelf - FIXED_SHELF_HOLES_FRONT_SHIFT_VALUE - FIXED_SHELF_FRONT_OFFSET") T AKF_FIXED_SHELF_DEP) 
								(_ FITTING_PARAMETERS nil))))
							(_HOLEGROUP operationName AK_RIGHT_PANEL_CODE rightPanelPointListForShelf (_ nil "Y-") connectorParams)
						)
					)
				)
			)
		)
	)
)
(_NONOTCH)
