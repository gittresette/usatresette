(setq wwg_layerName (ifnull gm1:layerName szBodyLayer))

(setq kodBlock (nxtBnam (lmm_sfRead kod)) )
(createGPanel
	(list 
		(list 0.0 0.0 0.0) 
		(list 10.0 0.0 0.0) 
		(list 10.0 ad_et 0.0) 
		(list 0.0 ad_et 0.0) 
	) 
	nil
	unitH
	0.0
	(d2r 90.0)
	(list 0.0 (- unitD) dAltKot)
	"YAN"
	""
	nil
	"SHELF"
	(strcat kodBlock "_" wwg_layerName)
	wwg_layerName
	"noedgedrawing"
)

(setq kodBlock (nxtBnam (lmm_sfRead kod)) )
(createGPanel
	(list 
		(list 0.0 0.0 0.0) 
		(list unitW 0.0 0.0) 
		(list unitW ad_et 0.0) 
		(list 0.0 ad_et 0.0) 
	) 
	nil
	unitH
	0.0
	0.0
	(list 0.0 (- unitD) dAltKot)
	"ON"
	""
	nil
	"SHELF"
	(strcat kodBlock "_" wwg_layerName)
	wwg_layerName
	"noedgedrawing"
)