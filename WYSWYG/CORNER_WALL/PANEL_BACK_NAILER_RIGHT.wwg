(setq wwg_layerName (ifnull gm1:layerName szBodyLayer))
(setq kodBlock (nxtBnam (lmm_sfRead kod)) )
(createGPanel 
	(list 
		(list 0.0 0.0 0.0) 
		(list (- unitW2 ad_et) 0.0 0.0) 
		(list (- unitW2 ad_et) 10 0.0) 
		(list 0.0 10 0.0) 
	) 
	nil
	ad_et 
	0.0
	(d2r 90.0) 
	(list 0.0 -1.8 (- (+ unitH dAltKot) 10) )
	"PANEL_BACK_RIGHT" 
	"" 
	nil 
	"SIDE" 
	(strcat kodBlock "_" wwg_layerName)
	wwg_layerName
	"noedgedrawing"
)

